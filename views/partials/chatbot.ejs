<button id="chat-toggle" class="fixed bottom-8 right-8 w-16 h-16 bg-blue-600 rounded-full shadow-2xl flex items-center justify-center text-white z-[100] animate-pulse-glow transition-transform hover:scale-110">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
</button>

<div id="chat-container" class="fixed bottom-28 right-8 w-[90%] md:w-96 h-[500px] glass rounded-[2rem] shadow-2xl z-[100] flex flex-col overflow-hidden translate-y-full opacity-0 pointer-events-none transition-all duration-500">
    <div class="p-4 bg-blue-600 text-white flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-white rounded-full p-1 overflow-hidden">
                <img src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=Lumi&backgroundColor=b6e3f4" alt="Lumi">
            </div>
            <div>
                <div class="font-bold">Lumi</div>
                <div class="text-xs text-blue-100 flex items-center">
                    <span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span> Online
                </div>
            </div>
        </div>
        <button id="chat-minimize" class="hover:bg-white/20 p-2 rounded-full transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
    </div>

    <div id="chat-messages" class="flex-grow p-4 overflow-y-auto chat-scroll space-y-4 bg-blue-50/50">
        <div class="flex items-start space-x-2">
            <div class="w-8 h-8 bg-white rounded-full p-1 shadow-sm flex-shrink-0">
                <img src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=Lumi&backgroundColor=b6e3f4" alt="Lumi">
            </div>
            <div class="bg-white p-3 rounded-2xl rounded-tl-none shadow-sm text-sm max-w-[80%]">
                Hi there! I'm Lumi. How can I help you today? ✨
            </div>
        </div>
    </div>

    <div class="px-4 py-2 flex space-x-2 overflow-x-auto chat-scroll no-scrollbar">
        <button class="suggestion-btn whitespace-nowrap bg-white border border-blue-100 px-3 py-1 rounded-full text-xs text-blue-600 hover:bg-blue-50 transition">Pricing plans?</button>
        <button class="suggestion-btn whitespace-nowrap bg-white border border-blue-100 px-3 py-1 rounded-full text-xs text-blue-600 hover:bg-blue-50 transition">Features?</button>
        <button class="suggestion-btn whitespace-nowrap bg-white border border-blue-100 px-3 py-1 rounded-full text-xs text-blue-600 hover:bg-blue-50 transition">Who is Lumi?</button>
    </div>

    <form id="chat-form" class="p-4 bg-white border-t border-blue-50 flex space-x-2">
        <input type="text" id="chat-input" class="flex-grow px-4 py-2 bg-slate-50 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Type a message...">
        <button type="submit" class="bg-blue-600 text-white p-2 rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
        </button>
    </form>
</div>

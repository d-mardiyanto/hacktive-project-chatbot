<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumi AI - Your Cute Futuristic Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/animations.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f9ff;
            overflow-x: hidden;
        }
    </style>
</head>
<body class="text-slate-800">

    <%- include('partials/nav') %>

    <!-- Hero Section -->
    <section id="home" class="relative min-h-screen flex items-center pt-20 overflow-hidden hero-gradient">
        <!-- Floating Bubbles -->
        <div class="bubble w-20 h-20 left-10" style="animation-delay: 0s;"></div>
        <div class="bubble w-32 h-32 left-1/4" style="animation-delay: 2s;"></div>
        <div class="bubble w-24 h-24 right-1/4" style="animation-delay: 4s;"></div>
        <div class="bubble w-16 h-16 right-10" style="animation-delay: 1s;"></div>

        <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center relative z-10">
            <div class="text-center md:text-left">
                <h1 class="text-5xl md:text-7xl font-extrabold leading-tight mb-6">
                    Meet <span class="text-blue-600 text-glow">Lumi</span>, Your AI Companion
                </h1>
                <p class="text-xl md:text-2xl text-slate-600 mb-10">
                    The most adorable, futuristic, and efficient AI assistant designed to boost your productivity with a smile.
                </p>
                <div class="flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
                    <a href="#get-started" class="bg-blue-600 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-blue-700 transition shadow-xl animate-pulse-glow">Get Started Free</a>
                    <a href="#contact" class="bg-white text-blue-600 border-2 border-blue-100 px-8 py-4 rounded-2xl font-bold text-lg hover:bg-blue-50 transition shadow-lg">Contact Us</a>
                </div>
            </div>
            <div class="flex justify-center relative">
                <div class="absolute inset-0 bg-blue-300 rounded-full filter blur-3xl opacity-20 animate-pulse"></div>
                <div class="w-72 h-72 md:w-[450px] md:h-[450px] bg-white rounded-full p-4 shadow-2xl animate-float flex items-center justify-center relative overflow-hidden">
                    <img src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=Lumi&backgroundColor=b6e3f4" alt="Lumi Mascot" class="w-full h-full object-contain">
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-24 bg-white">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-bold mb-4">About Lumi AI</h2>
                <p class="text-slate-600 text-lg">We are on a mission to humanize AI and make technology accessible, friendly, and incredibly powerful for everyone.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="p-8 rounded-3xl glass-dark border-blue-50 shadow-xl hover:-translate-y-2 transition duration-300 text-center">
                    <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center mb-6 mx-auto">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Our Company</h3>
                    <p class="text-slate-600">Founded in 2024, Lumi AI was born from a desire to bridge the gap between complex AI logic and delightful user experiences.</p>
                </div>
                <div class="p-8 rounded-3xl glass-dark border-blue-50 shadow-xl hover:-translate-y-2 transition duration-300 text-center">
                    <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center mb-6 mx-auto">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Our Mission</h3>
                    <p class="text-slate-600">To empower creative minds by automating the mundane, giving you more time to focus on what makes you unique.</p>
                </div>
                <div class="p-8 rounded-3xl glass-dark border-blue-50 shadow-xl hover:-translate-y-2 transition duration-300 text-center">
                    <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center mb-6 mx-auto">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold mb-3">Our Vision</h3>
                    <p class="text-slate-600">A world where AI is a trusted companion, helping humanity reach its full potential with kindness and efficiency.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 blue-gradient relative">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center gap-16">
                <div class="md:w-1/2">
                    <h2 class="text-4xl font-bold mb-6 text-blue-900 text-glow">Advanced Features</h2>
                    <div class="space-y-6">
                        <div class="flex items-start space-x-4">
                            <div class="mt-1 flex-shrink-0 w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center text-white">✓</div>
                            <div>
                                <h4 class="font-bold text-lg">Smart Task Automation</h4>
                                <p class="text-blue-800/70">Let Lumi handle scheduling, email drafting, and data entry automatically.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4">
                            <div class="mt-1 flex-shrink-0 w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center text-white">✓</div>
                            <div>
                                <h4 class="font-bold text-lg">Real-time Collaboration</h4>
                                <p class="text-blue-800/70">Sync with your team across any device with instant updates.</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4">
                            <div class="mt-1 flex-shrink-0 w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center text-white">✓</div>
                            <div>
                                <h4 class="font-bold text-lg">Insightful Analytics</h4>
                                <p class="text-blue-800/70">Get deep insights into your productivity patterns with AI analysis.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2 grid grid-cols-2 gap-4">
                    <div class="space-y-4">
                        <div class="h-40 glass rounded-3xl shadow-lg border-white/50 flex items-center justify-center text-blue-500">
                             <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
                        </div>
                        <div class="h-60 glass rounded-3xl shadow-lg border-white/50 flex items-center justify-center text-blue-500">
                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
                        </div>
                    </div>
                    <div class="space-y-4 pt-8">
                        <div class="h-60 glass rounded-3xl shadow-lg border-white/50 flex items-center justify-center text-blue-500">
                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        </div>
                        <div class="h-40 glass rounded-3xl shadow-lg border-white/50 flex items-center justify-center text-blue-500">
                            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Gallery -->
    <section id="gallery" class="py-24 bg-white">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-bold mb-4">Take a Look Inside</h2>
                <p class="text-slate-600 text-lg">Experience the beautiful, minimalist interface that makes Lumi a joy to use every day.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="group relative overflow-hidden rounded-3xl shadow-xl">
                    <img src="https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&fit=crop&q=80&w=800" alt="Dashboard" class="w-full h-64 object-cover transform group-hover:scale-110 transition duration-500">
                    <div class="absolute inset-0 bg-blue-600/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="text-white font-bold text-xl">Smart Dashboard</span>
                    </div>
                </div>
                <div class="group relative overflow-hidden rounded-3xl shadow-xl">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800" alt="Analytics" class="w-full h-64 object-cover transform group-hover:scale-110 transition duration-500">
                    <div class="absolute inset-0 bg-blue-600/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="text-white font-bold text-xl">AI Analytics</span>
                    </div>
                </div>
                <div class="group relative overflow-hidden rounded-3xl shadow-xl">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=800" alt="Collaboration" class="w-full h-64 object-cover transform group-hover:scale-110 transition duration-500">
                    <div class="absolute inset-0 bg-blue-600/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="text-white font-bold text-xl">Team Sync</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="py-24 hero-gradient">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-4xl font-bold mb-4">Simple, Transparent Pricing</h2>
                <p class="text-slate-600 text-lg">Choose the plan that's right for you or your team.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                <!-- Basic -->
                <div class="bg-white p-10 rounded-[3rem] shadow-xl border border-blue-50 flex flex-col items-center text-center">
                    <h3 class="text-xl font-bold mb-4">Starter</h3>
                    <div class="text-4xl font-bold mb-6">$0<span class="text-lg text-slate-400">/mo</span></div>
                    <ul class="space-y-4 mb-10 text-slate-600 flex-grow">
                        <li>Basic AI Assistant</li>
                        <li>5 Projects</li>
                        <li>Community Support</li>
                    </ul>
                    <a href="#" class="w-full py-3 rounded-2xl border-2 border-blue-600 text-blue-600 font-bold hover:bg-blue-50 transition">Get Started</a>
                </div>
                <!-- Pro -->
                <div class="bg-blue-600 p-10 rounded-[3rem] shadow-2xl shadow-blue-200 flex flex-col items-center text-center transform scale-105 relative z-10">
                    <div class="absolute top-0 right-0 bg-white text-blue-600 px-4 py-1 rounded-bl-2xl rounded-tr-[3rem] text-sm font-bold">POPULAR</div>
                    <h3 class="text-xl font-bold mb-4 text-white">Professional</h3>
                    <div class="text-4xl font-bold mb-6 text-white">$29<span class="text-lg text-blue-200">/mo</span></div>
                    <ul class="space-y-4 mb-10 text-blue-50 flex-grow">
                        <li>Advanced AI Features</li>
                        <li>Unlimited Projects</li>
                        <li>Priority Support</li>
                        <li>Custom Integrations</li>
                    </ul>
                    <a href="#" class="w-full py-3 rounded-2xl bg-white text-blue-600 font-bold hover:bg-blue-50 transition shadow-lg">Go Pro</a>
                </div>
                <!-- Enterprise -->
                <div class="bg-white p-10 rounded-[3rem] shadow-xl border border-blue-50 flex flex-col items-center text-center">
                    <h3 class="text-xl font-bold mb-4">Enterprise</h3>
                    <div class="text-4xl font-bold mb-6">Custom</div>
                    <ul class="space-y-4 mb-10 text-slate-600 flex-grow">
                        <li>Dedicated Infrastructure</li>
                        <li>SLA Guarantee</li>
                        <li>Dedicated Account Manager</li>
                        <li>Advanced Security</li>
                    </ul>
                    <a href="#" class="w-full py-3 rounded-2xl border-2 border-blue-600 text-blue-600 font-bold hover:bg-blue-50 transition">Contact Sales</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="py-24 bg-white overflow-hidden">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl font-bold text-center mb-16">Loved by Thousands</h2>
            <div class="flex space-x-8 animate-[scroll_40s_linear_infinite] whitespace-nowrap">
                <div class="inline-block w-80 p-8 glass-dark rounded-3xl border-blue-50 shadow-lg whitespace-normal">
                    <p class="text-slate-600 mb-6">"Lumi has completely changed how I manage my tasks. It's like having a personal assistant who never gets tired!"</p>
                    <div class="flex items-center space-x-4">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" class="w-12 h-12 rounded-full bg-blue-100">
                        <div>
                            <div class="font-bold">Alex Rivera</div>
                            <div class="text-sm text-slate-400">Product Manager</div>
                        </div>
                    </div>
                </div>
                 <div class="inline-block w-80 p-8 glass-dark rounded-3xl border-blue-50 shadow-lg whitespace-normal">
                    <p class="text-slate-600 mb-6">"The interface is so cute and friendly. I actually enjoy using my productivity apps now!"</p>
                    <div class="flex items-center space-x-4">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Sarah" alt="User" class="w-12 h-12 rounded-full bg-blue-100">
                        <div>
                            <div class="font-bold">Sarah Chen</div>
                            <div class="text-sm text-slate-400">Freelance Designer</div>
                        </div>
                    </div>
                </div>
                <div class="inline-block w-80 p-8 glass-dark rounded-3xl border-blue-50 shadow-lg whitespace-normal">
                    <p class="text-slate-600 mb-6">"Powerful AI wrapped in a beautiful package. Highly recommended for any scaling team."</p>
                    <div class="flex items-center space-x-4">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=James" alt="User" class="w-12 h-12 rounded-full bg-blue-100">
                        <div>
                            <div class="font-bold">James Wilson</div>
                            <div class="text-sm text-slate-400">Tech Lead</div>
                        </div>
                    </div>
                </div>
                 <div class="inline-block w-80 p-8 glass-dark rounded-3xl border-blue-50 shadow-lg whitespace-normal">
                    <p class="text-slate-600 mb-6">"Lumi has completely changed how I manage my tasks. It's like having a personal assistant who never gets tired!"</p>
                    <div class="flex items-center space-x-4">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" class="w-12 h-12 rounded-full bg-blue-100">
                        <div>
                            <div class="font-bold">Alex Rivera</div>
                            <div class="text-sm text-slate-400">Product Manager</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-24 blue-gradient">
        <div class="container mx-auto px-6 max-w-5xl">
            <div class="bg-white rounded-[3rem] shadow-2xl overflow-hidden flex flex-col md:flex-row">
                <div class="md:w-1/2 p-12 bg-blue-600 text-white">
                    <h2 class="text-4xl font-bold mb-6">Get in Touch</h2>
                    <p class="text-blue-100 mb-10">Have questions? We're here to help you get started with Lumi.</p>
                    <div class="space-y-6">
                        <div class="flex items-center space-x-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            <span>hello@lumiai.com</span>
                        </div>
                        <div class="flex items-center space-x-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <span>San Francisco, CA</span>
                        </div>
                    </div>
                    <div class="mt-12 flex space-x-4">
                        <a href="#" class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center hover:bg-white/40 transition">T</a>
                        <a href="#" class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center hover:bg-white/40 transition">L</a>
                        <a href="#" class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center hover:bg-white/40 transition">I</a>
                    </div>
                </div>
                <div class="md:w-1/2 p-12">
                    <form class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold mb-2">Name</label>
                            <input type="text" class="w-full px-4 py-3 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="John Doe">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Email</label>
                            <input type="email" class="w-full px-4 py-3 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="john@example.com">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">Message</label>
                            <textarea class="w-full px-4 py-3 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition h-32" placeholder="How can we help?"></textarea>
                        </div>
                        <button class="w-full bg-blue-600 text-white py-4 rounded-2xl font-bold hover:bg-blue-700 transition shadow-lg">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <%- include('partials/chatbot') %>

    <script src="/js/chat.js"></script>
</body>
</html>
